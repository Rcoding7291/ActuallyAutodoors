<?xml version="1.0" encoding="UTF-8"?>
<Patch>
    <Operation Class="PatchOperationSequence">
        <operations>
            <li Class="PatchOperationConditional">
                <xpath>/Defs/StatDef[defName="DoorOpenSpeed"]/parts</xpath>
                <match Class="PatchOperationAdd">
                    <xpath>/Defs/StatDef[defName="DoorOpenSpeed"]/parts</xpath>
                    <value>
                        <li Class="ActuallyAutodoors.StatPart_WideAutodoorMinimumSpeed"/>
                        <li Class="ActuallyAutodoors.StatPart_AdvancedReinforcedWideAutodoorMinimumSpeed"/>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/StatDef[defName="DoorOpenSpeed"]</xpath>
                    <value>
                        <parts>
                            <li Class="ActuallyAutodoors.StatPart_WideAutodoorMinimumSpeed"/>
                            <li Class="ActuallyAutodoors.StatPart_AdvancedReinforcedWideAutodoorMinimumSpeed"/>
                        </parts>
                    </value>
                </nomatch>
            </li>
        </operations>
    </Operation>
</Patch>
