<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ActuallyAutodoors</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Assemblies/Actually_Autodoors_Minimum.cs" />
    <Compile Include="Assemblies/Actually_Autodoors_AAD_Minimum.cs" />
    <Compile Include="Assemblies/Actually_Autodoors_ARAD_Minimum.cs" />
    <Compile Include="../Assemblies/Actually_Autodoors_ARAD_Minimum.cs" />
    <Compile Include="../Assemblies/Actually_Autodoors_BRAD_Minimum.cs" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)/RimWorldLinux_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldDir)/RimWorldLinux_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
  <Target Name="PrepareActiveDoorSources" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)ReviewSources" />
    <Exec Command="sed 's/1\.f/1.0f/g' &quot;$(MSBuildProjectDirectory)/../Assemblies/Actually_Autodoors_AAD_Minimum.cs&quot; &gt; &quot;$(IntermediateOutputPath)ReviewSources/Actually_Autodoors_AAD_Minimum.cs&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ReviewSources/Actually_Autodoors_AAD_Minimum.cs" />
    </ItemGroup>
  </Target>
</Project>