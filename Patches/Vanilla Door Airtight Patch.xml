                    <value>
                        <isStuffableAirtight>false</isStuffableAirtight>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ThingDef[defName="OrnateDoor"]/building</xpath>
