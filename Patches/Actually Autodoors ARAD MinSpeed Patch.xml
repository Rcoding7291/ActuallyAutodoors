<?xml version="1.0" encoding="UTF-8"?>
<Patch>
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/StatDef[defName="DoorOpenSpeed"]/parts</xpath>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/StatDef[defName="DoorOpenSpeed"]/parts</xpath>
            <value>
                <li Class="ActuallyAutodoors.StatPart_ReinforcedAutodoorMinimumSpeed" />
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/StatDef[defName="DoorOpenSpeed"]</xpath>
            <value>
                <parts>
                    <li Class="ActuallyAutodoors.StatPart_AdvancedReinforcedAutodoorMinimumSpeed" />
                </parts>
            </value>
        </nomatch>
    </Operation>
</Patch>