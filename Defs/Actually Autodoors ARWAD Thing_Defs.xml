        <statBases>
            <MaxHitPoints>750</MaxHitPoints>
            <Flammability>0.0</Flammability>
            <WorkToBuild>4200</WorkToBuild>
            <DoorOpenSpeed>1.5</DoorOpenSpeed>
        </statBases>
        <graphicData>
            <texPath>Textures_Actually_Autodoors/Advanced Reinforced Wide Autodoor Mover</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <damageData>
                <enabled>false</enabled>
            </damageData>
