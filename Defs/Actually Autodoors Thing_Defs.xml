<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingDef ParentName="DoorBase">
        <defName>Advanced_Autodoor</defName>
        <DefName>Advanced_AutoDoor</DefName>
        <label>Advanced Autodoor</label>
        <description>An automatic door that opens when someone approaches. It is faster than a normal autodoor but it requires power to operate. If the power is cut off, it will function as a normal door.</description>
        <statBases>
            <MaxHitPoints>200</MaxHitPoints>
            <Flammability>0.00</Flammability>
            <WorkToBuild>500</WorkToBuild>
            <DoorOpenSpeed>1.10</DoorOpenSpeed>
        </statBases>
        <graphicData>
            <texPath>Things/Building/Structure/AutoDoor/AutoDoor_Mover</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <damageData>
                <enabled>false</enabled>
            </damageData>
        </graphicData>

        <costList>
            <Steel>50</Steel>
            <ComponentIndustrial>4</ComponentIndustrial>
        </costList>
        <costStuffCount>25</costStuffCount>
        <researchPrerequisites>
            <li>Advanced Autodoors</li>
        </researchPrerequisites>
        <uiIconPath>Things/Building/Structure/AutoDoor/AutoDoor_MenuIcon</uiIconPath>
        <stuffCategories>
            <li>Metallic</li>
            <li>Woody</li>
            <li>Stony</li>
        </stuffCategories>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>25</basePowerConsumption>
            </li>
            <li Class="compproperties_breakdownable"/>
            <li Class="compproperties_autodoors">
                <compClass>CompAutoDoor</compClass>
                <openDelay>0.0</openDelay>
                <closeDelay>0.5</closeDelay>
            </li>
            <li Class= "compproperties_Stylable"/>
        </comps>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
         <building>
             <isStuffableAirtight>true</isStuffableAirtight>
        </building>
    </ThingDef>
</Defs>