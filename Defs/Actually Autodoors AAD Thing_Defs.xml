<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingDef Name="Advanced_Autodoors" ParentName="DoorBase">
        <defName>Advanced_Autodoors</defName>
        <label>Advanced Autodoor</label>
        <description>An automatic door that opens when someone approaches. It is faster than a normal autodoor but it requires power to operate. If the power is cut off, it will function as a normal door.</description>
        <statBases>
            <MaxHitPoints>350</MaxHitPoints>
            <Flammability>0.0</Flammability>
            <WorkToBuild>2500</WorkToBuild>
            <DoorOpenSpeed>1.50</DoorOpenSpeed>
        </statBases>
        <graphicData>
            <texPath>Textures_Actually_Autodoors/Advanced Autodoor Mover</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawRotated>false</drawRotated>
            <damageData>
                <enabled>false</enabled>
            </damageData>
        </graphicData>
        <uiIconPath>Textures_Actually_Autodoors/Advanced Autodoor</uiIconPath>
        <category>Building</category>
        <selectable>true</selectable>
        <costList>
            <Steel>50</Steel>
            <ComponentIndustrial>8</ComponentIndustrial>
        </costList>
        <costStuffCount>25</costStuffCount>
        <researchPrerequisites>
            <li>Advanced_Autodoors</li>
        </researchPrerequisites>
        <stuffCategories>
            <li>Metallic</li>
            <li>Woody</li>
            <li>Stony</li>
        </stuffCategories>
        <comps>
            <li Class="CompProperties_Breakdownable"/>
            <li Class= "CompProperties_Styleable"/>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>50</basePowerConsumption>
            </li>
        </comps>
        <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
         <building>
             <isStuffableAirtight>true</isStuffableAirtight>
        </building>
    </ThingDef>
</Defs>